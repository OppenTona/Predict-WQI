            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Comparative assessment</rdf:li>
               <rdf:li>Cumulative ranking</rdf:li>
               <rdf:li>Karkheh</rdf:li>
               <rdf:li>Leave-One-Out Cross Validation (LOOCV)</rdf:li>
               <rdf:li>Linear and Nonlinear conditions</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A Comparative Assessment of Artificial Neural Network, Generalized Regression Neural Network, Least-Square Support Vector Regression, and K-Nearest Neighbor Regression for Monthly Streamflow Forecasting in Linear and Nonlinear Conditions</rdf:li>
